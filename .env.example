# TronGrid API Key (get one at https://www.trongrid.io/)
TRONGRID_API_KEY=

# Private key (hex, no 0x prefix) — required for signing transactions
# WARNING: Never commit this file with a real key. Use .env (gitignored).
TRON_PRIVATE_KEY=

# Post-quantum examples (pq-transfer, pq-migrate): keystore written by examples/pq-keys
PQ_KEYSTORE=
# Keystore passphrase. Leave empty to be prompted (recommended).
PQ_KEYSTORE_PASSWORD=
